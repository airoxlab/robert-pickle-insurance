# Rendered at container start by nginx's envsubst entrypoint, so the
# platform-injected $PORT becomes the real listen directive.
server {
    listen       ${PORT};
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # /contact and /contact.html both work.
    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }

    location = / {
        try_files /index.html =404;
    }

    # Hashless filenames, so HTML must revalidate; assets can sit a while.
    location ~* \.html$ {
        add_header Cache-Control "no-cache";
    }

    location ~* \.(css|js|svg|png|jpg|jpeg|webp|ico|woff2)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }

    error_page 404 /index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/plain text/css text/javascript application/javascript application/xml image/svg+xml;
    gzip_min_length 1024;
}
